{
  "name": "dsh-session-focus",
  "version": "0.1.0",
  "description": "Focus marks for DeepSeek Harness: flag the Sessions you are actually working on, park the ones you are waiting on, and keep the count visible even when workspace folders are collapsed. | DSH 焦点标记：标出正在做的会话、把等外部的挂起，工作区折叠时也看得见还有几条在手上。",
  "license": "MIT",
  "author": "凡世祥 <759448154@qq.com>",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "sidebar",
    "focus",
    "productivity"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  }
}
